  <Scene>
    <Transform translation="0 0 0">
      <Shape>
        <Appearance>
          <Material diffuseColor="0.8 0.2 0.2"/> <!-- Red color -->
        </Appearance>
        <Sphere radius="1.5"/>
      </Shape>
    </Transform>
  </Scene>
</X3D>